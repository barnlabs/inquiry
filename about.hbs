<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark light"><title>BarnLabs Inquiry — Third-party licenses</title><style>:root{--bg:#07100f;--panel:#111a19;--ink:#f5f3ec;--muted:#9aa8a2;--line:#29413c;--accent:#66e3d4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,sans-serif}main{width:min(980px,calc(100% - 28px));margin:32px auto}header,section{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px;margin-bottom:16px}h1{font-size:clamp(32px,6vw,56px);line-height:1}a{color:var(--accent)}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:420px;overflow:auto;background:#08110f;padding:16px;border-radius:10px}.used{color:var(--muted)}@media(prefers-color-scheme:light){:root{--bg:#eef4f1;--panel:#fff;--ink:#10211d;--muted:#526762;--line:#bdd0ca;--accent:#087d71}pre{background:#f4f7f5}}</style></head><body><main><header><div>BARNLABS / INQUIRY</div><h1>Third-party licenses</h1><p>This inventory is generated from the locked Rust dependency graph. It is included with binary distributions and fails generation when an unreviewed license appears.</p></header><section><h2>License overview</h2><ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul></section>{{#each licenses}}<section>{{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}<h3 id="{{id}}-{{@index}}">{{name}}</h3><div class="used">Used by: {{#each used_by}}<a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}}, {{/unless}}{{/each}}</div><pre>{{text}}</pre></section>{{/each}}</main></body></html>
